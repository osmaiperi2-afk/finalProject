{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "▶ Run All Tests",
      "type": "npm",
      "script": "test",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "▶ Run API Tests",
      "type": "npm",
      "script": "test:api",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "▶ Run UI Tests",
      "type": "npm",
      "script": "test:ui",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    },
    {
      "label": "▶ Run Current Feature File",
      "type": "shell",
      "command": "npx cucumber-js ${relativeFile} --config cucumber.js",
      "group": "test",
      "presentation": {
        "reveal": "always",
        "panel": "new"
      }
    }
  ]
}
