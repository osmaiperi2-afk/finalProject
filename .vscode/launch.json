{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Current Feature",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/@cucumber/cucumber/bin/cucumber-js",
      "args": [
        "${file}",
        "--config",
        "cucumber.js"
      ],
      "cwd": "${workspaceFolder}",
      "runtimeArgs": [
        "-r",
        "ts-node/register"
      ],
      "console": "integratedTerminal"
    }
  ]
}